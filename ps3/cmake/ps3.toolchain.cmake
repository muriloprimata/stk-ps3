set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR powerpc64)
set(PS3DEV "$ENV{PS3DEV}")
set(PS3_SHIM "${CMAKE_CURRENT_LIST_DIR}/../shim")
set(CMAKE_C_COMPILER   ${CMAKE_CURRENT_LIST_DIR}/../bin/ppu-gcc)
set(CMAKE_CXX_COMPILER ${CMAKE_CURRENT_LIST_DIR}/../bin/ppu-g++)
set(CMAKE_AR           ${PS3DEV}/ppu/bin/powerpc64-ps3-elf-ar CACHE FILEPATH "")
set(CMAKE_RANLIB       ${PS3DEV}/ppu/bin/powerpc64-ps3-elf-ranlib CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(PS3_FLAGS "-mcpu=cell -fsigned-char -I${PS3_SHIM} -I${PS3DEV}/ppu/include -I${PS3DEV}/portlibs/ppu/include")
set(CMAKE_C_FLAGS_INIT   "${PS3_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${PS3_FLAGS}")
set(CMAKE_FIND_ROOT_PATH ${PS3DEV}/ppu ${PS3DEV}/portlibs/ppu)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
